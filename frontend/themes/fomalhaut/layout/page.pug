extends includes/layout.pug

block content
  -
    var generatedPageTypes = ['tags', 'categories', 'link', 'echarts', 'redirect']
    var hasGeneratedContent = generatedPageTypes.indexOf(page.type) !== -1
    var hasBodyContent = String(page.content || '').replace(/<!--[\s\S]*?-->/g, '').trim().length > 0
    var hasComments = page.comments !== false && theme.comments && theme.comments.use
    var isEmptyPage = !hasGeneratedContent && !hasBodyContent && !hasComments
  #page(class=isEmptyPage ? 'page-empty' : undefined)
    if top_img === false
      h1.page-title= page.title

    case page.type
      when 'tags'
        include includes/page/tags.pug
      when 'link'
        include includes/page/flink.pug
      when 'categories'
        include includes/page/categories.pug
      when 'echarts'
        include includes/page/echarts.pug
      when 'redirect'
        include includes/page/redirect.pug
      default
        include includes/page/default-page.pug

    if page.comments !== false && theme.comments && theme.comments.use
      - var commentsJsLoad = true
      !=partial('includes/third-party/comments/index', {}, {cache: true})
