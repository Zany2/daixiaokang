- const { readmode, translate, darkmode, aside, chat_btn } = theme
mixin rightsideItem(array)
  each item in array
    case item
      when 'readmode'
        if is_post() && readmode
          button#readmode(type="button" title=_p('rightside.readmode_title'))
            i.fas.fa-book-open
      when 'translate'
        if translate.enable
          button#translateLink(type="button" title=_p('rightside.translate_title'))= translate.default
      when 'darkmode'
        if darkmode.enable && darkmode.button
          //- button#darkmode(type="button" title=_p('rightside.night_mode_title'))
          //-   i.fas.fa-adjust
          a.icon-V.hidden(onclick='switchNightMode()',  title=_p('rightside.night_mode_title'))
            svg(width='25', height='25', viewBox='0 0 1024 1024')
              use#modeicon(xlink:href='#icon-moon')
      //- when 'hideAside'
      //-   if aside.enable && aside.button && page.aside !== false
      //-     button#hide-aside-btn(type="button" title=_p('rightside.aside'))
      //-       i.fas.fa-arrows-alt-h
      when 'toc'
        if showToc
          button#mobile-toc-button.close(type="button" title=_p("rightside.toc"))
            i.fas.fa-list-ul
      when 'chat'
        if chat_btn
          button#chat_btn(type="button" title=_p("rightside.chat"))
            i.fas.fa-sms
      when 'comment'
        if commentsJsLoad || customFeedbackLoaded
          a#to_comment(href=page.type === 'guestbook' ? '#guestbook-board' : '#post-comment' title=_p("rightside.scroll_to_comment"))
            i.fas.fa-comments
      //- when 'bg'
      //-   button(type="button" title='切换背景' onclick="toggleWinbox()")
      //-     i.fa.fa-picture-o

      when 'share'
        button.share(type="button" title='分享链接' onclick="share()")
          i.fas.fa-share-nodes

      when 'mouse'
        button.share(type="button" title='右键模式' onclick="changeMouseMode()")
          i.fas.fa-mouse


#rightside
  - const { enable, hide, show } = theme.rightside_item_order
  - const hideArray = enable ? hide && hide.split(',') : ['readmode','translate','darkmode','hideAside', 'mouse']
  - const showArray = enable ? show && show.split(',') : ['toc','chat','share','comment']
  //- - const showArray = enable ? show && show.split(',') : ['toc','chat','bg','comment']
  
  #rightside-config-hide
    if hideArray
      +rightsideItem(hideArray)
  #rightside-config-show
    if enable
      if hide
        button#rightside_config(type="button" title=_p("rightside.setting"))
          i.fas.fa-cog.right_side
    else
      if is_post()
        if (readmode || translate.enable || (darkmode.enable && darkmode.button))
          button#rightside_config(type="button" title=_p("rightside.setting"))
            i.fas.fa-cog.right_side
      //- else if translate.enable || (darkmode.enable && darkmode.button)
      else if hideArray
        button#rightside_config(type="button" title=_p("rightside.setting"))
          i.fas.fa-cog.right_side

    if showArray
      +rightsideItem(showArray)

    button#go-up(type="button" title=_p("rightside.back_to_top"))
      i.fas.fa-arrow-up
      span#percent 0
        span %

    button#go-down(type="button" title="直达底部" onclick="btf.scrollToDest(document.body.scrollHeight, 500)")
      i.fas.fa-arrow-down

  //- 独立的首页控制组：位置仍在工具栏末尾，不受普通侧边部件的隐藏开关影响。
  //- 所有页面保留容器，方便 PJAX 在离开、返回首页时同步替换。
  #rightside-home-controls
    if useHomeCinematic
      button#home-intro-sound.home-intro-control(type='button' hidden title='关闭视频声音' aria-label='关闭视频声音' aria-pressed='true')
        i.fas.fa-volume-high(aria-hidden='true')
      button#home-intro-skip.home-intro-control(type='button' hidden title='跳过动画' aria-label='跳过首页开场视频，显示首页内容')
        i.fas.fa-forward-step(aria-hidden='true')
      button#home-intro-replay.home-intro-control(type='button' hidden title='重播背景视频' aria-label='从头重播首页背景视频')
        i.fas.fa-rotate-right(aria-hidden='true')

  //- 始终留在工具栏最下方，用于收起或重新展开页面悬浮界面。
  #rightside-ui-control
    button#site-ui-toggle(type='button' title='收起页面菜单、文字与悬浮部件' aria-label='收起页面菜单、文字与悬浮部件' aria-pressed='false')
      i.fas.fa-eye-slash(aria-hidden='true')
