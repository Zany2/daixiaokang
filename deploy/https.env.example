# Copy to https.env on the server, fill in the values, and chmod 600 https.env.
# Docker Compose env_file format. Never commit real credentials.
ACME_EMAIL=''

# Tencent Cloud API credentials with DNSPod TXT record management permissions.
# These are SecretId/SecretKey, not DNSPod's legacy ID/Token pair.
Tencent_SecretId=''
Tencent_SecretKey=''

# Daily renewal check at 03:15, using Asia/Shanghai (set in Compose).
HTTPS_CRON='15 3 * * *'
