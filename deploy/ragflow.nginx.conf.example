# Install as /daixk/components/gateway/conf.d/ragflow.conf only after
# the installed certificate includes ragflow.daixiaokang.com.
# Both gateway and ragflow must be attached to mynetwork.
server {
    listen 80;
    server_name ragflow.daixiaokang.com;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    http2 on;
    server_name ragflow.daixiaokang.com;

    ssl_certificate /etc/nginx/ssl/fullchain.pem;
    ssl_certificate_key /etc/nginx/ssl/privkey.pem;

    client_max_body_size 256m;

    location / {
        resolver 127.0.0.11 valid=30s ipv6=off;
        set $ragflow_upstream http://ragflow:80;
        proxy_pass $ragflow_upstream;

        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;

        proxy_buffering off;
        proxy_cache off;
        gzip off;
        proxy_connect_timeout 10s;
        proxy_read_timeout 600s;
        proxy_send_timeout 600s;
    }
}
