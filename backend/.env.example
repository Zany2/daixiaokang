# =============================================================================
# 应用基础配置
# =============================================================================
# OpenAPI 文档中展示的服务名称。
APP_NAME=Zany API
# 当前后端版本号。
APP_VERSION=0.1.0
# 可选值：development / testing / staging / production。
ENVIRONMENT=development
# 开启后 FastAPI 会输出更详细的调试信息；生产环境必须设为 false。
DEBUG=false
# 是否开放 Swagger、ReDoc 与 OpenAPI JSON；生产环境可按需关闭。
DOCS_ENABLED=false

# =============================================================================
# HTTP 服务配置
# =============================================================================
# 监听地址。0.0.0.0 允许容器或局域网访问，127.0.0.1 仅允许本机访问。
HOST=0.0.0.0
# FastAPI 服务监听端口。
PORT=8000

# =============================================================================
# PostgreSQL / SQLAlchemy 配置
# =============================================================================
# 异步数据库连接地址：postgresql+asyncpg://用户名:密码@主机:端口/数据库名
# PostgreSQL 中需要先创建此处指定的数据库。
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/zany
# 是否输出 SQLAlchemy SQL 日志；排查 SQL 时临时开启，生产环境建议关闭。
DATABASE_ECHO=false
# 数据库连接池常驻连接数。
DATABASE_POOL_SIZE=10
# 连接池耗尽后允许临时创建的额外连接数。
DATABASE_MAX_OVERFLOW=20
# true：应用启动时根据 SQLAlchemy models 自动创建数据库中缺失的表。
# create_all 只补缺失表，不会删除已有表，也不会修改已有字段。
# 开启此项时，启动必须能够连接 PostgreSQL。
DATABASE_AUTO_CREATE=true

# =============================================================================
# Redis 配置
# =============================================================================
# Redis 连接地址：redis://[:密码]@主机:端口/数据库编号
REDIS_URL=redis://localhost:6379/0

# =============================================================================
# 跨域与主机安全配置
# =============================================================================
# 允许访问 API 的前端来源，必须使用 JSON 数组格式且包含协议与端口。
CORS_ORIGINS=["http://localhost:4000","http://127.0.0.1:4000"]
# 是否允许跨域请求携带 Cookie 或 Authorization 等凭据。
CORS_ALLOW_CREDENTIALS=true
# 允许的 HTTP 方法和请求头，必须使用 JSON 数组格式。
CORS_ALLOW_METHODS=["*"]
CORS_ALLOW_HEADERS=["*"]
# 允许的 Host 请求头，生产环境需要加入正式 API 域名。
TRUSTED_HOSTS=["localhost","127.0.0.1"]

# =============================================================================
# 日志配置
# =============================================================================
# Python 日志级别：DEBUG / INFO / WARNING / ERROR / CRITICAL。
LOG_LEVEL=INFO
# false 输出便于本地阅读的文本日志；true 输出适合日志平台采集的 JSON 日志。
LOG_JSON=false
# 是否同时写入日志文件；关闭后仅输出到控制台。
LOG_FILE_ENABLED=true
# 日志目录：相对路径以 backend 为基准，也支持绝对路径。
LOG_DIR=logs
# 日期与大小切分产生的备份合计保留最近 15 份；超出后自动删除旧备份。
# 当前 app.log 不计入备份数量；日期切分在跨日后的第一条日志写入时触发。
LOG_BACKUP_COUNT=15
# 默认按本地日期切分；预计写入后达到此大小时也切分（MB，1 MB = 1024 * 1024 字节）。
# 单条日志保持完整，极大的单条日志可能超过此限制。
LOG_MAX_SIZE_MB=20

# =============================================================================
# 启动与依赖检查
# =============================================================================
# true：启动时必须成功连接 PostgreSQL 和 Redis，否则拒绝启动。
# false：跳过额外的连接检查；DATABASE_AUTO_CREATE=true 时仍需连接 PostgreSQL。
STARTUP_CHECK_DEPENDENCIES=false
