# =============================================================================
# 应用基础配置
# =============================================================================
# OpenAPI 文档中展示的服务名称。
APP_NAME=Zany API
# 当前后端版本号。
APP_VERSION=0.1.0
# 运行环境，可选 development、testing、staging 或 production。
ENVIRONMENT=development
# 是否启用 FastAPI 调试模式，生产环境必须设为 false。
DEBUG=false
# 是否开放 Swagger、ReDoc 和 OpenAPI JSON。
DOCS_ENABLED=false

# =============================================================================
# HTTP 服务配置
# =============================================================================
# 监听地址，0.0.0.0 允许外部访问，127.0.0.1 仅允许本机访问。
HOST=0.0.0.0
# FastAPI 服务监听端口。
PORT=8000

# =============================================================================
# 跨域与主机安全配置
# =============================================================================
# 允许访问 API 的前端来源，使用包含协议和端口的 JSON 数组。
CORS_ORIGINS=["http://localhost:4000","http://127.0.0.1:4000","https://daixiaokang.com","https://www.daixiaokang.com"]
# 是否允许跨域请求携带 Cookie 或 Authorization 等凭据。
CORS_ALLOW_CREDENTIALS=true
# 允许跨域请求使用的 HTTP 方法，使用 JSON 数组。
CORS_ALLOW_METHODS=["*"]
# 允许跨域请求携带的请求头，使用 JSON 数组。
CORS_ALLOW_HEADERS=["*"]
# 允许的 Host 请求头，生产环境应包含正式 API 域名。
TRUSTED_HOSTS=["localhost","127.0.0.1","daixiaokang.com","www.daixiaokang.com"]

# =============================================================================
# 日志配置
# =============================================================================
# Python 日志级别，可选 DEBUG、INFO、WARNING、ERROR 或 CRITICAL。
LOG_LEVEL=INFO
# 是否输出适合日志平台采集的 JSON 格式日志。
LOG_JSON=false
# 是否在控制台输出之外同时写入日志文件。
LOG_FILE_ENABLED=true
# 日志目录，相对路径以 backend 为基准，也支持绝对路径。
LOG_DIR=logs
# 日期和大小切分产生的日志备份总保留数量。
LOG_BACKUP_COUNT=15
# 单个日志文件触发大小切分的阈值，单位为 MB。
LOG_MAX_SIZE_MB=10

# =============================================================================
# 启动与依赖检查
# =============================================================================
# 是否要求启动时成功连接 PostgreSQL 和 Redis。
STARTUP_CHECK_DEPENDENCIES=false

# =============================================================================
# PostgreSQL / SQLAlchemy 配置
# =============================================================================
# 异步 PostgreSQL 连接地址，目标数据库需要提前创建。
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/zany
# 是否输出 SQLAlchemy SQL 日志，生产环境建议关闭。
DATABASE_ECHO=false
# 数据库连接池常驻连接数。
DATABASE_POOL_SIZE=10
# 连接池耗尽后允许临时创建的额外连接数。
DATABASE_MAX_OVERFLOW=20
# 是否在启动时创建缺失表，只补表且不会迁移已有结构。
DATABASE_AUTO_CREATE=true

# =============================================================================
# Redis 配置
# =============================================================================
# Redis 连接地址，格式为 redis://[:密码]@主机:端口/数据库编号。
REDIS_URL=redis://localhost:6379/0
# Redis 单次连接、读取和操作的超时时间，单位为秒。
REDIS_OPERATION_TIMEOUT_SECONDS=1

# =============================================================================
# 评论 / 留言限流
# =============================================================================
# 是否启用评论、回复和留言的发表与查询限流。
FEEDBACK_RATE_LIMIT_ENABLED=true
# 同一 IP 连续发表评论、回复或留言的最短间隔秒数。
FEEDBACK_WRITE_INTERVAL_SECONDS=10
# 同一 IP 每分钟允许调用评论和留言查询接口的总次数。
FEEDBACK_READ_REQUESTS_PER_MINUTE=120

# =============================================================================
# AI 助手配置
# =============================================================================
# 是否开放 AI 对话接口。
AI_ENABLED=true
# 兼容 OpenAI Chat Completions 的模型服务地址。
AI_API_BASE=https://api.deepseek.com
# 模型服务密钥，只保存在后端环境变量中。
AI_API_KEY=
# 后端固定使用的模型名称，前端传入的 model 不会覆盖它。
AI_MODEL=deepseek-chat
# AI 助手的系统提示词，前端传入的 system 消息不会覆盖它。
AI_SYSTEM_PROMPT=你是一位通用 AI 助手，帮助用户解答问题、学习知识、编写代码、整理文字和规划任务。默认用中文自然、清晰地回答，根据问题调整详略，必要时使用 Markdown。信息不足时先澄清，不确定的内容如实说明，不编造事实或声称执行了未执行的操作。
# 系统提示词版本，用于追溯历史会话采用的提示规则。
AI_SYSTEM_PROMPT_VERSION=v1
# 模型回复的采样温度。
AI_TEMPERATURE=0.7
# 单次用户问题允许输入的最大字符数。
AI_MAX_INPUT_CHARS=1000
# 单次回复允许生成的最大 token 数。
AI_MAX_TOKENS=1024
# 携带最近多少轮完整且成功的问答；当前问题和系统提示词另外添加。
AI_MAX_HISTORY_TURNS=6
# 是否启用 AI 接口的每 IP 请求限流。
AI_RATE_LIMIT_ENABLED=true
# 同一 IP 每小时允许发起的 AI 对话次数。
AI_REQUESTS_PER_HOUR=30
# 同一 IP 每小时允许创建的新会话数量。
AI_CONVERSATIONS_PER_HOUR=10
# AI 会话最后活跃后的有效小时数。
AI_CONVERSATION_TTL_HOURS=24
# 同一会话生成锁的有效时间，单位为秒。
AI_CONVERSATION_LOCK_SECONDS=120
# 等待模型返回数据的超时时间，单位为秒。
AI_REQUEST_TIMEOUT_SECONDS=60
