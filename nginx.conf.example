# Public example. Copy to the live configuration path before editing.
# Local: repository root nginx.conf -> Server: frontend/nginx.conf
# Requires Nginx >= 1.25.1 (the Compose nginx:latest image supports http2 on).
worker_processes auto;

events {
    worker_connections 1024;
}

http {
    include /etc/nginx/mime.types;
    default_type application/octet-stream;
    charset utf-8;
    server_tokens off;
    sendfile on;
    tcp_nopush on;
    keepalive_timeout 65;

    access_log /var/log/nginx/access.log;
    error_log /var/log/nginx/error.log warn;

    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_certificate /etc/nginx/ssl/fullchain.pem;
    ssl_certificate_key /etc/nginx/ssl/privkey.pem;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 1d;
    ssl_session_tickets off;

    gzip on;
    gzip_vary on;
    gzip_proxied any;
    gzip_comp_level 5;
    gzip_min_length 1024;
    gzip_types text/plain text/css text/xml application/javascript
               application/json application/xml application/rss+xml
               application/atom+xml image/svg+xml;

    # API responses must never be cached. HTML, search indexes and the service
    # worker must revalidate. Only successful static responses get a one-day TTL.
    # Do not use immutable: the current build also uses unversioned filenames.
    map "$status:$uri" $response_cache_control {
        default "no-cache";
        "~^[0-9]{3}:/api(?:/|$)" "no-store";
        "~^[0-9]{3}:/(?:sw|service-worker)\\.js$" "no-cache";
        "~*^(200|206|304):/.*\\.(?:css|js|mjs|png|jpe?g|gif|webp|avif|svg|ico|woff2?|ttf|otf|eot|mp4|webm|mov|mp3|ogg|wav|pdf)$" "public, max-age=86400";
    }

    add_header Cache-Control $response_cache_control always;
    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy strict-origin-when-cross-origin always;

    # Resolve the backend through Docker DNS after container recreation.
    resolver 127.0.0.11 valid=30s ipv6=off;

    # static.daixiaokang.com is served by EdgeOne -> COS, outside this Nginx.
    # If the main site later uses EdgeOne, use HTTPS origin port 443 and keep
    # the matching Host. Configure real IP handling only with verified EdgeOne
    # origin CIDRs and its documented client-IP header; never trust all IPs.

    server {
        listen 80;
        server_name daixiaokang.com api.daixiaokang.com;
        return 301 https://$host$request_uri;
    }

    server {
        listen 443 ssl;
        http2 on;
        server_name daixiaokang.com;

        root /usr/share/nginx/html;
        index index.html;

        location = /api {
            return 308 /api/$is_args$args;
        }

        # ^~ keeps API paths (including paths ending in .js/.json) out of
        # static-file handlers. Variable proxy_pass preserves the original URI.
        location ^~ /api/ {
            set $backend http://daixiaokang_backend:8000;
            proxy_pass $backend;
            proxy_http_version 1.1;
            proxy_set_header Connection "";
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            # Replace untrusted client-supplied XFF. With a future trusted CDN,
            # the real-IP module must normalize $remote_addr before this point.
            proxy_set_header X-Forwarded-For $remote_addr;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_hide_header Cache-Control;
            proxy_hide_header Expires;
            proxy_hide_header X-Content-Type-Options;
            proxy_hide_header Referrer-Policy;
            proxy_buffering off;
            proxy_cache off;
            proxy_intercept_errors off;
            proxy_connect_timeout 5s;
            proxy_send_timeout 60s;
            proxy_read_timeout 180s;
            gzip off;
        }

        # Do not expose dotfiles such as .env or .git if accidentally uploaded.
        location ~ (^|/)\\. {
            return 404;
        }

        # Missing resources must remain 404, rather than returning homepage HTML.
        location ~* \\.(?:css|js|mjs|map|json|xml|txt|webmanifest|png|jpe?g|gif|webp|avif|svg|ico|woff2?|ttf|otf|eot|mp4|webm|mov|mp3|ogg|wav|pdf)$ {
            try_files $uri =404;
        }

        location / {
            error_page 404 = @homepage;
            try_files $uri $uri/ $uri.html =404;
        }

        location @homepage {
            return 302 /;
        }
    }

    server {
        listen 443 ssl;
        http2 on;
        server_name api.daixiaokang.com;

        location = /api {
            return 308 /api/$is_args$args;
        }

        location ^~ /api/ {
            set $backend http://daixiaokang_backend:8000;
            proxy_pass $backend;
            proxy_http_version 1.1;
            proxy_set_header Connection "";
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $remote_addr;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_hide_header Cache-Control;
            proxy_hide_header Expires;
            proxy_hide_header X-Content-Type-Options;
            proxy_hide_header Referrer-Policy;
            proxy_buffering off;
            proxy_cache off;
            proxy_intercept_errors off;
            proxy_connect_timeout 5s;
            proxy_send_timeout 60s;
            proxy_read_timeout 180s;
            gzip off;
        }

        location / {
            return 404;
        }
    }
}
